<UserControl x:Class="UrbanCareClient.WPF.Views.UserControls.MaterialControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.UserControls"
             mc:Ignorable="d" 
             MaxWidth="1700"
             
             HorizontalAlignment="Stretch">
    <Border x:Name="LayoutRoot" BorderBrush="#DDD" BorderThickness="0,0,0,1" Padding="10" Background="White">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="IdTxt" Text="1" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="5 0"/>

                <TextBlock x:Name="NameTxt" Grid.Column="1" Text="Труба пластиковая" Style="{StaticResource SecondaryText}" VerticalAlignment="Center"  TextWrapping="Wrap" Margin="5 0"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="5 0">
                <TextBlock Text="Склад:" VerticalAlignment="Center"/>
                <TextBlock x:Name="StorageTxt" Text="Склад труб №2" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </StackPanel>

            <TextBlock x:Name="PriceTxt" Grid.Column="3" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="5 0"/>

            <StackPanel Grid.Column="4" VerticalAlignment="Center" Orientation="Horizontal" Margin="5 0">
                <TextBlock Text="На складе:" VerticalAlignment="Center" Margin="0,0,3,0" Style="{StaticResource SecondaryText}"/>
                <TextBlock x:Name="AmountAtStorageTxt" Text="2" Style="{StaticResource SecondaryText}" VerticalAlignment="Center" />
                <TextBlock x:Name="UnitTxt" Text="шт." VerticalAlignment="Center" Margin="3,0,0,0" Style="{StaticResource SecondaryText}"/>
            </StackPanel>

            <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center" Margin="5 0">
                <Button x:Name="AddBtn" Content="+" Style="{StaticResource SecondaryButton}" Padding="3 0"  BorderThickness="0.7" Width="20" Height="20" Margin="0,0,4,0" Click="AddBtn_Click" IsEnabled="False"/>
                <TextBlock x:Name="QuantityTxt" Text="0" VerticalAlignment="Center" Style="{StaticResource SecondaryText}" Margin="0,0,4,0"/>
                <Button x:Name="RemoveBtn" Content="-" Style="{StaticResource SecondaryButton}" Padding="3 0" BorderThickness="0.7" Width="20" Height="20" Margin="0,0,4,0" Click="RemoveBtn_Click" IsEnabled="False"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
