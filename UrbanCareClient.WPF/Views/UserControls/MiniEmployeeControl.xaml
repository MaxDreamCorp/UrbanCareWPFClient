<UserControl x:Class="UrbanCareClient.WPF.Views.UserControls.MiniEmployeeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.UserControls"
             mc:Ignorable="d" 
            Margin="0 10" >
    <Grid x:Name="LayoutRoot">

        <Border CornerRadius="15" Background="{StaticResource BackgroundBrush}" Padding="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Image Grid.Row="0" Grid.Column="0" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/AccountIcon.png" Width="40" />
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="10 0 0 10">
                    <TextBlock x:Name="FullnameTxt" Text="Иванов Иван Иванович"  FontSize="14" VerticalAlignment="Center"/>
                    <TextBlock x:Name="PositionTxt" Text="Дворник" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                    <Border x:Name="StatusBdr" Padding="6 2" Height="20" VerticalAlignment="Center" Background="{StaticResource PriorityMediumBgBrush}" CornerRadius="10" HorizontalAlignment="Left" >
                        <TextBlock x:Name="StatusTxt" Text="На заказа" FontWeight="Bold" Foreground="{StaticResource PriorityMediumBrush}" FontSize="11"/>
                    </Border>
                    <TextBlock x:Name="PhoneTxt" Text="+79678876452" Style="{StaticResource SecondaryText}" FontSize="11" VerticalAlignment="Center"/>
                    <TextBlock x:Name="EmailTxt" Text="maxmalk220@gmail.com" Style="{StaticResource SecondaryText}" FontSize="11"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
