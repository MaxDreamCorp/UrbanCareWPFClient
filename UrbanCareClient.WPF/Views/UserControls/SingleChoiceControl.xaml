<UserControl x:Class="UrbanCareClient.WPF.Views.UserControls.SingleChoiceControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.UserControls"
             mc:Ignorable="d" 
             >
    <Grid>
        <StackPanel>
            <TextBlock x:Name="Label" Text="{Binding LabelText}" Style="{StaticResource SecondaryText}"/>
            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                <TextBox x:Name="SelectedItemTxt" MinWidth="250" Style="{StaticResource ChoseElement}" IsTabStop="False"/>
                <Button x:Name="ChooseBtn" Click="ChooseBtn_Click" Style="{StaticResource SecondaryButton}" Content="Выбрать" Margin="5,0,0,0" IsTabStop="False"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
