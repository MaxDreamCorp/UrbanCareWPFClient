<UserControl
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.UserControls"
             xmlns:ViewModels="clr-namespace:UrbanCareClient.WPF.Views.UserControls.ViewModels" x:Class="UrbanCareClient.WPF.Views.UserControls.OrderControl"
            MinWidth="450"
            Margin="0 10"
             mc:Ignorable="d" >
    <Grid x:Name="LayoutRoot">
        <Grid.DataContext>
            <ViewModels:OrderControlViewModel/>
        </Grid.DataContext>
        <Border CornerRadius="15" Background="{StaticResource BackgroundBrush}" Padding="15">
        <StackPanel VerticalAlignment="Top">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock x:Name="HeaderTxt" Text="Заказ #1" Style="{StaticResource PageTitle}" VerticalAlignment="Center" Margin="0,0,0,0"/>
                    <Border x:Name="StatusBdr" Padding="8 4" Height="25" VerticalAlignment="Center" Background="{StaticResource InProgressBgBrush}" CornerRadius="10" Margin="5,0,0,0">
                        <TextBlock x:Name="StatusTxt" FontSize="14" Text="В работе" FontWeight="Bold" Foreground="{StaticResource InProgressBrush}"/>
                    </Border>
            </StackPanel>
                <TextBlock x:Name="DescriptionTxt" Style="{StaticResource SecondaryText}" Text="gggggggggggg" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Приоритетность:" VerticalAlignment="Center" Margin="0,0,5,0" />
                <Border x:Name="PriorityBdr" Padding="8 4" Height="25" VerticalAlignment="Center" Background="{StaticResource PriorityMediumBgBrush}" CornerRadius="10" HorizontalAlignment="Left" >
                    <TextBlock x:Name="PriorityTxt" FontSize="14" Text="Средний" FontWeight="Bold" Foreground="{StaticResource PriorityMediumBrush}"/>
                </Border>
                </StackPanel>
                <Grid Margin="0 0 0 5">
                    <Grid.RowDefinitions>
                        <RowDefinition/>
                        <RowDefinition/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0 5">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/CategoryIcon.png" Width="24" Margin="0,0,5,0" />
                        <TextBlock x:Name="CategoryTxt" Style="{StaticResource SecondaryText}" Text="Сантехника" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0 5">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/TypeIcon.png" Width="24" Margin="0,0,5,0" />
                        <TextBlock x:Name="TypeTxt" Style="{StaticResource SecondaryText}" Text="Внутриквартирные работы" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0 5">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/AddressIcon.png" Width="24" Margin="0,0,5,0" />
                        <TextBlock x:Name="AddressTxt" Style="{StaticResource SecondaryText}" Text="ул. Ленина, д. 22, кв. 1" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0 5">
                        <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/CalendarIcon.png" Width="24" Margin="0,0,5,0" />
                        <TextBlock x:Name="DateTxt" Style="{StaticResource SecondaryText}" Text="15.03.2025" VerticalAlignment="Center"/>
                    </StackPanel>
                </Grid>

                <Border Background="White" CornerRadius="15" Padding="10">
                    <StackPanel x:Name="ContactPanel">
                        <TextBlock Text="Мои контактные данные:" Style="{StaticResource SecondaryText}" Foreground="Black" FontWeight="DemiBold"/>
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/PhoneIcon.png" Width="24" Margin="0,0,5,0" />
                            <TextBlock x:Name="ContactPhoneTxt" Style="{StaticResource SecondaryText}" Text="+796788764522" VerticalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0">
                            <Image RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/EmailIcon.png" Width="24" Margin="0,0,5,0" />
                            <TextBlock x:Name="ContactEmailTxt" Style="{StaticResource SecondaryText}" Text="maxmalk220@gmail.com" VerticalAlignment="Center"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border x:Name="InWorkPanel" Visibility="Collapsed"  Background="White" CornerRadius="15" Padding="10" Margin="0 5">
                    <StackPanel Margin="0,10"  Background="White">
                        <TextBlock Text="Исполнительская информация:" Style="{StaticResource SecondaryText}" Foreground="Black" FontWeight="DemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DispatcherTxt" Text="" Style="{StaticResource SecondaryText}"/>
                        <TextBlock x:Name="ExecutorsTxt" Text="" Style="{StaticResource SecondaryText}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>


                <Border x:Name="PaymentPanel" Visibility="Collapsed" Background="White" CornerRadius="15" Padding="10" Margin="0 5">
                    <StackPanel Margin="0,10" Background="White">
                        <TextBlock Text="Расходники и оплата работы:" Style="{StaticResource SecondaryText}" Foreground="Black" FontWeight="DemiBold" Margin="0,0,0,6"/>
                        <TextBlock x:Name="MaterialsTxt" Text="" Style="{StaticResource SecondaryText}" TextWrapping="Wrap" Visibility="Collapsed" Margin="0,0,0,6"/>
                        <TextBlock x:Name="PaymentTxt" Text="" FontWeight="Bold" FontSize="16"/>
                        <Button x:Name="PayBtn" Content="Оплатить" Style="{StaticResource PrimaryButton}" Margin="0,5,0,0" HorizontalAlignment="Left" Click="PayBtn_Click"/>
                    </StackPanel>
                </Border>

                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" Margin="0 10 0 0">
                    <Button x:Name="ConfirmCompletionBtn" Style="{StaticResource PrimaryButton}" Content="Подтвердить выполнение" Visibility="Collapsed" Click="ConfirmCompletionBtn_Click" Width="250" Height="30" Margin="0,0,10,0"/>
                    <Button x:Name="MoreBtn" Style="{StaticResource SecondaryButton}" Content="Подробнее" Click="MoreBtn_Click" />
                    
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
