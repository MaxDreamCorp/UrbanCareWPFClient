<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.AppointingExecutorToOrderModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        SizeToContent="WidthAndHeight"
        Title="Назначить испольнителей заказа">
    <StackPanel>

        <TextBlock Text="Назначить исполнителей заказа" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" Margin="15"/>
        <StackPanel Background="{StaticResource BackgroundBrush}" x:Name="OrderPanel" Margin="15 0"/>
        <StackPanel Margin="15">
            <TextBlock Text="Исполнители:" Style="{StaticResource SectionTitleText}" HorizontalAlignment="Left"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="ExecutorsPanel"/>
            </ScrollViewer>
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="AppointBtn" Height="35" FontSize="14" Content="Назначить" Style="{StaticResource PrimaryButton}" Margin="15" Grid.Column="1" Click="AppointBtn_Click"/>
            <Button x:Name="CancelBtn" Height="35" FontSize="14" Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="15" Grid.Column="0" Click="CancelBtn_Click"/>

        </Grid>
    </StackPanel>
</Window>
