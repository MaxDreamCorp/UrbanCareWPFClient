<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.RegistrationModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows"
        mc:Ignorable="d"
        Style="{StaticResource Win}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        Title="Регистрация" Width="800" Loaded="Window_Loaded">
    <Grid>
        <StackPanel Margin="0 15">
            <TextBlock Text="Регистрация" Style="{StaticResource PageTitle}"/>
            <StackPanel x:Name="InputPanel" Margin="30 0">
                <Border BorderBrush="#E3E8EF" BorderThickness="0.5,0.5,0.5,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                </Grid.RowDefinitions>
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="ФИО:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="FullnameInp" Margin="0,5,0,0" FontSize="14" MaxLength="255" MaxLines="1" TextChanged="FullnameInp_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Email:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="EmailInp" Margin="0,5,0,0" FontSize="14" MaxLength="150" MaxLines="1" TextChanged="EmailInp_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Телефон:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="PhoneInp" Margin="0,5,0,0" FontSize="14" MaxLength="20" MaxLines="1" TextChanged="PhoneInp_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <TextBlock Text="Дата рождения:" Style="{StaticResource SecondaryText}"/>
                    <DatePicker x:Name="DateOfBirthInp" Margin="0,5,0,0" FontSize="14" SelectedDateChanged="DateOfBirthInp_SelectedDateChanged" />
                </StackPanel>
                  <StackPanel Grid.Row="2" Grid.Column="0" Margin="5">
                    <TextBlock Text="Роль:" FontSize="14" Style="{StaticResource SecondaryText}"/>
                    <ComboBox x:Name="RoleInp" Margin="0,5,0,0" FontSize="14" SelectionChanged="RoleInp_SelectionChanged" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="1" Margin="5">
                    <TextBlock Text="СНИЛС:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="SnilsInp" Margin="0,5,0,0" FontSize="14" MaxLength="14" MaxLines="1" TextChanged="SnilsInp_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="0" Margin="5">
                    <TextBlock Text="ИНН:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="InnInp" Margin="0,5,0,0" FontSize="14" MaxLength="12" MaxLines="1" TextChanged="InnInp_TextChanged" />
                </StackPanel>
                <StackPanel Grid.Row="3" Grid.Column="1" Margin="5">
                    <TextBlock Text="Пароль:" Style="{StaticResource SecondaryText}"/>
                    <PasswordBox x:Name="PasswordInp" Margin="0,5,0,0" FontSize="14" PasswordChanged="PasswordInp_PasswordChanged" />
                    <TextBlock Text="Подтверждение пароля:" Style="{StaticResource SecondaryText}"/>
                    <PasswordBox x:Name="ConfirmPasswordInp" Margin="0,5,0,0" FontSize="14" PasswordChanged="ConfirmPasswordInp_PasswordChanged" />
                </StackPanel>
             
                
    </Grid>
            </Border>

                <Border BorderBrush="#E3E8EF" BorderThickness="0.5">
                <StackPanel>
                    <TextBlock Text="Паспортные данные" FontSize="16" FontWeight="Bold"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                            <TextBlock Text="Серия:" Style="{StaticResource SecondaryText}"/>
                            <TextBox x:Name="PassportDataSeriaInp" Margin="0,5,0,0" FontSize="14" MaxLength="4" MaxLines="1" TextChanged="PassportDataSeriaInp_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                            <TextBlock Text="Номер:" Style="{StaticResource SecondaryText}"/>
                            <TextBox x:Name="PassportDataNumberInp" Margin="0,5,0,0" FontSize="14" MaxLength="6" MaxLines="1" TextChanged="PassportDataNumberInp_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                            <TextBlock Text="Выдан:" Style="{StaticResource SecondaryText}"/>
                            <TextBox x:Name="PassportDataDepartmentInp" Margin="0,5,0,0" FontSize="14" TextChanged="PassportDataDepartmentInp_TextChanged" />
                        </StackPanel>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="Код подразделения:" Style="{StaticResource SecondaryText}"/>
                            <TextBox x:Name="PassportDataDepartmentCodeInp" Margin="0,5,0,0" FontSize="14" MaxLines="1" MaxLength="7" TextChanged="PassportDataDepartmentCodeInp_TextChanged" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
            <Button x:Name="LogInBtn" Content="Зарегистрироваться" Click="LogInBtn_Click" HorizontalAlignment="Center" Width="180" Height="35" Style="{StaticResource PrimaryButton}" Margin="0,30,0,20" />
        </StackPanel>
    </Grid>
</Window>
