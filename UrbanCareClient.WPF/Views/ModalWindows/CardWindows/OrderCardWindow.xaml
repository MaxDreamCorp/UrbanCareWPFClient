<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.CardWindows.OrderCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows.CardWindows"
        mc:Ignorable="d"
               Style="{StaticResource Win}"
        WindowStartupLocation="CenterOwner"
               SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Title="Заказ" MinWidth="500">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="BackBtn" Grid.Column="0" Content="Назад" Style="{StaticResource SecondaryButton}" Click="BackBtn_Click"/>
            <TextBlock x:Name="CardHeaderTxt" Grid.Column="1" Text="Создать заказ" Style="{StaticResource PageTitle}" Margin="10,5,10,5" HorizontalAlignment="Left" FontSize="20"/>
            <Button x:Name="SaveBtn" Grid.Column="2" Content="Сохранить" Style="{StaticResource PrimaryButton}" Click="SaveBtn_Click"/>
        </Grid>

        <StackPanel Grid.Row="1">
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="ID: " VerticalAlignment="Center"/>
                <TextBox x:Name="IdInp" BorderBrush="{DynamicResource BorderBrush}" Margin="0,5,0,0" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Заявитель: " VerticalAlignment="Center"/>
                <TextBox x:Name="ResidentInp" BorderBrush="{DynamicResource BorderBrush}" Margin="0,5,0,0" IsReadOnly="True" />
            </StackPanel>
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Описание проблемы: " VerticalAlignment="Center"/>
                <TextBox x:Name="DescriptionInp" BorderBrush="{DynamicResource BorderBrush}" Margin="0,5,0,0" TextWrapping="Wrap" MinHeight="60"/>
            </StackPanel>
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Тип: " VerticalAlignment="Center"/>
                <ComboBox x:Name="TypeInp" Margin="0,5,0,0" SelectionChanged="TypeInp_SelectionChanged"/>
            </StackPanel>
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Категория: " VerticalAlignment="Center"/>
                <ComboBox x:Name="CategoryInp" Margin="0,5,0,0" />
            </StackPanel>

            <StackPanel Margin="0 10" x:Name="BuildingPanel"/>
            <StackPanel Margin="0 10" x:Name="ApartmentPanel"/>
            <StackPanel Margin="0 10">
                <TextBlock Style="{StaticResource SecondaryText}" Text="Приоритетность: " VerticalAlignment="Center"/>
                <ComboBox x:Name="PriorityyInp" Margin="0,5,0,0" />
            </StackPanel>

            <Border BorderBrush="{StaticResource SecondaryTextBrush}" BorderThickness="0 0.3" Padding="0 10" Margin="0 10">
                <StackPanel>
                    <TextBlock Style="{StaticResource SecondaryText}" Text="Контактные данные:" FontSize="14" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0 10 10 10">
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Контактная почта: " VerticalAlignment="Center"/>
                            <TextBox x:Name="ContactEmailInp" BorderBrush="{DynamicResource BorderBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="0 10">
                            <TextBlock Style="{StaticResource SecondaryText}" Text="Контактный телефон: " VerticalAlignment="Center"/>
                            <TextBox x:Name="ContactPhoneInp" BorderBrush="{DynamicResource BorderBrush}" Margin="0,5,0,0" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>

    </Grid>
</Window>
