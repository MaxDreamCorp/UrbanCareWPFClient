<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.CardWindows.ManagementCompanyCardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows.CardWindows"
        Style="{StaticResource Win}"
        mc:Ignorable="d"
        Title="Управляющая компания" Height="120" Width="400" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
        <Button x:Name="BackBtn" Content="Назад" HorizontalAlignment="Left" Click="BackBtn_Click"/>
        <Button x:Name="SaveBtn" Content="Сохранить" HorizontalAlignment="Right" Click="SaveBtn_Click"/>
            <Grid Margin="10" Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    
                </Grid.RowDefinitions>
                <TextBlock Text="Название компании:" Grid.Column="0" Grid.Row="0"/>
                <TextBox x:Name="NameInp" Grid.Row="0" Grid.Column="1"/>
                <TextBlock Text="Адрес:" Grid.Column="0" Grid.Row="2"/>
                <TextBox x:Name="AddressInp" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </Grid>
        
    </Grid>
</Window>
