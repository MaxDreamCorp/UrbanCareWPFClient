<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.SetWorkPaymentModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows"
        mc:Ignorable="d"
            SizeToContent="WidthAndHeight"
        Title="Сумма оплата">
    <StackPanel>

        <TextBlock Text="Укажите сумму оплаты вашей работы" Style="{StaticResource PageTitle}" HorizontalAlignment="Left" Margin="15"/>
        <StackPanel Background="{StaticResource BackgroundBrush}" x:Name="OrderPanel" Margin="15 0"/>
        <TextBox x:Name="PaymentTextBox" Margin="15 0" Background="{StaticResource BackgroundBrush}" FontSize="14" MaxLength="150" MaxLines="1"/>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="SetBtn" Height="35" FontSize="14" Content="Назначить" Style="{StaticResource PrimaryButton}" Margin="15" Grid.Column="1" Click="SetBtn_Click"/>
            <Button x:Name="CancelBtn" Height="35" FontSize="14" Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="15" Grid.Column="0" Click="CancelBtn_Click"/>

        </Grid>
    </StackPanel>
</Window>
