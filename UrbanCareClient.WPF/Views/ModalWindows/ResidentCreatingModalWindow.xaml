<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.ResidentCreatingModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows"
        mc:Ignorable="d"
                Loaded="Window_Loaded"
        Style="{StaticResource Win}"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
Title="Регистрация жителя" Width="800">
    <Grid>
        <StackPanel Margin="0 15">
            <TextBlock Text="Регистрация жителя" Style="{StaticResource PageTitle}"/>
            <StackPanel x:Name="InputPanel" Margin="30 0">
                <Border BorderBrush="#E3E8EF" BorderThickness="0.5,0.5,0.5,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition/>
                            <RowDefinition/>
                        </Grid.RowDefinitions>
                        <StackPanel x:Name="RegionPanel" Grid.Row="0" Grid.Column="0" Margin="5"/>
                        <StackPanel x:Name="BuildingPanel" Grid.Row="0" Grid.Column="1" Margin="5"/>
                        <StackPanel x:Name="ApartmentPanel" Grid.Row="1" Grid.Column="0" Margin="5"/>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                            <TextBlock Text="Дата въезда:" Style="{StaticResource SecondaryText}"/>
                            <DatePicker x:Name="MovingIntoDateInp" Margin="0,5,0,0" FontSize="14" SelectedDateChanged="MovingIntoDateInp_SelectedDateChanged" />
                        </StackPanel>
                     

                    </Grid>
                </Border>
            </StackPanel>
            <Button x:Name="RegistrateBtn" Content="Зарегистрироваться" Click="RegistrateBtn_Click" HorizontalAlignment="Center" Width="180" Height="35" Style="{StaticResource PrimaryButton}" Margin="0,30,0,20" />
        </StackPanel>
    </Grid>
</Window>
