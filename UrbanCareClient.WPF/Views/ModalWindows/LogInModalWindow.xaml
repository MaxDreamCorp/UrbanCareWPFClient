<Window x:Class="UrbanCareClient.WPF.Views.ModalWindows.LogInModalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.ModalWindows"
        mc:Ignorable="d"
        Style="{StaticResource Win}"
        SizeToContent="WidthAndHeight"
        Loaded="Window_Loaded"
        Title="Авторизация" MinWidth="400">
    <Grid>
        <StackPanel Margin="50 20">
            <TextBlock Text="Авторизация" Style="{StaticResource PageTitle}"/>
            <StackPanel x:Name="InpPanel" Margin="0,0,0,30" >
                <StackPanel Margin="0 25 0 0">
                    <TextBlock Text="Логин:" Style="{StaticResource SecondaryText}"/>
                    <TextBox x:Name="LoginInp" Margin="0,5,0,0" FontSize="14" TextChanged="LoginInp_TextChanged" />
                </StackPanel>
                <StackPanel Margin="0 25 0 0">
                    <TextBlock Text="Пароль:" Style="{StaticResource SecondaryText}"/>
                    <PasswordBox x:Name="Passwordnp" Margin="0,5,0,0" FontSize="14" PasswordChanged="Passwordnp_PasswordChanged" />
                </StackPanel>
            </StackPanel>
            <StackPanel>
                <Button x:Name="LogInBtn" Content="Войти" Click="LogInBtn_Click" HorizontalAlignment="Center" Width="130" Height="35" Style="{StaticResource PrimaryButton}" />
                <Button x:Name="RegistrationBtn" Content="Регистрация" Click="RegistrationBtn_Click" HorizontalAlignment="Center" Width="130" Height="35" Style="{StaticResource SecondaryButton}" Margin="0,15,0,0" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
