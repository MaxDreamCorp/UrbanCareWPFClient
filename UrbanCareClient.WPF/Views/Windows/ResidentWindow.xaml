<Window x:Class="UrbanCareClient.WPF.Views.Windows.ResidentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UrbanCareClient.WPF.Views.Windows"
        mc:Ignorable="d"
        Loaded="Window_Loaded"
        Title="Житель: Главная" MinHeight="450" MinWidth="800">
    <Window.Background>
        <SolidColorBrush Color="{StaticResource BackgroundColor}"/>
    </Window.Background>
    <ScrollViewer>
        <Grid >
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"  Padding="15 10"  Background="White">
                <DockPanel >
                    <StackPanel Orientation="Horizontal">
                        <Image  RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/MCIcon.png" Width="35" />
                        <StackPanel HorizontalAlignment="Left" >
                            <TextBlock x:Name="MCNameTxt" Margin="5,5,5,0" Text="УК 'Санрайз Сити'"  FontWeight="Bold" FontSize="14"/>
                            <TextBlock  Margin="5,3,5,5" Text="Личный кабинет жителя" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel>
                            <TextBlock x:Name="FullNameTxt" Margin="5,5,5,0" Text="Иванов Иван Иванович"  FontWeight="Bold" FontSize="12"/>
                            <TextBlock x:Name="PositionTxt" Margin="5,0,5,10" Text="Житель" FontSize="11" Style="{StaticResource SecondaryText}" HorizontalAlignment="Right"/>
                        </StackPanel>
                        <Image  RenderOptions.BitmapScalingMode="HighQuality" Width="35" Source="/Resources/Images/AccountIcon.png"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <StackPanel Grid.Row="1" Margin="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" CornerRadius="15" Background="White" Padding="10" Margin="10,0,10,0">
                        <StackPanel>
                            <Image Margin="5" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/NewOrderIcon.png" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="NewOrdersTxt" Margin="5,5,5,0" Text="0"  FontWeight="Bold" FontSize="16"/>
                            <TextBlock  Margin="5,3,5,5" Text="Новых заказов" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" CornerRadius="15" Background="White" Padding="10"  Margin="10,0,10,0">
                        <StackPanel>
                            <Image Margin="5" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/InProgressIcon.png" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="InProgressOrdersTxt" Margin="5,5,5,0" Text="0"  FontWeight="Bold" FontSize="16"/>
                            <TextBlock  Margin="5,3,5,5" Text="В работе" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" CornerRadius="15" Background="White" Padding="10" Margin="10,0,10,0">
                        <StackPanel>
                            <Image Margin="5" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/WaitingForPaymentIcon.png" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="WaitingForPaymentOrdersTxt" Margin="5,5,5,0" Text="0"  FontWeight="Bold" FontSize="16"/>
                            <TextBlock  Margin="5,3,5,5" Text="Ожидают оплаты" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" CornerRadius="15" Background="White" Padding="10" Margin="10,0,10,0">
                        <StackPanel>
                            <Image Margin="5" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/FinishedIcon.png" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="FinishedOrdersTxt" Margin="5,5,5,0" Text="0"  FontWeight="Bold" FontSize="16"/>
                            <TextBlock  Margin="5,3,5,5" Text="Завершены" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" CornerRadius="15" Background="White" Padding="10" Margin="10,0,10,0">
                        <StackPanel>
                            <Image Margin="5" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/CanceledIcon.png" Width="40" HorizontalAlignment="Left"/>
                            <TextBlock x:Name="CanceledOrdersTxt" Margin="5,5,5,0" Text="0"  FontWeight="Bold" FontSize="16"/>
                            <TextBlock  Margin="5,3,5,5" Text="Отменены" FontSize="11" Style="{StaticResource SecondaryText}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Background="White" Padding="10" CornerRadius="15" Margin="10" x:Name="ActiveOrders" MouseLeftButtonDown="ActiveOrders_MouseLeftButtonDown">
                        <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock Text="Активные заказы" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" >
                            <Button x:Name="CreateOrderBtn" Style="{StaticResource PrimaryButton}" Content="Создать заказ" Click="CreateOrderBtn_Click"/>
                                <StackPanel Margin="10,0,0,0" Orientation="Horizontal" >
                                    <Image x:Name="ActiveOrderChevronUp" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronUp.png" Width="15" VerticalAlignment="Center" />
                                    <Image x:Name="ActiveOrderChevronDown" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronDown.png" Width="15" VerticalAlignment="Center" Visibility="Collapsed"/>
                                </StackPanel>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="ActiveOrdersPanel" />
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="10" CornerRadius="15" Margin="10,0,10,10" x:Name="WaitingForPaymentOrders" MouseLeftButtonDown="WaitingForPaymentOrders_MouseLeftButtonDown">
                    <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock Text="Ожидающие оплаты заказы" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                        <StackPanel Margin="10,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" >
                            <Image x:Name="WaitingForPaymentOrderChevronUp" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronUp.png" Width="15" VerticalAlignment="Center" />
                            <Image x:Name="WaitingForPaymentOrderChevronDown" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronDown.png" Width="15" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="WaitingForPaymentOrdersPanel" />
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="10" CornerRadius="15" Margin="10,0,10,10" x:Name="FinishedOrders" MouseLeftButtonDown="FinishedOrders_MouseLeftButtonDown">
                    <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock Text="Завершенные заказы" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" >
                                <Image x:Name="FinishedOrderChevronUp" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronUp.png" Width="15" VerticalAlignment="Center" />
                                <Image x:Name="FinishedOrderChevronDown" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronDown.png" Width="15" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="FinishedOrdersPanel" />
                    </StackPanel>
                </Border>
                <Border Background="White" Padding="10" CornerRadius="15" Margin="10,0,10,10" x:Name="CanceledOrders" MouseLeftButtonDown="CanceledOrders_MouseLeftButtonDown">
                    <StackPanel>
                        <DockPanel Margin="10">
                            <TextBlock Text="Отмененные заказы" FontWeight="Bold" FontSize="12" VerticalAlignment="Center"/>
                            <StackPanel Margin="10,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" >
                                <Image x:Name="CanceledOrderChevronUp" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronUp.png" Width="15" VerticalAlignment="Center" />
                                <Image x:Name="CanceledOrderChevronDown" RenderOptions.BitmapScalingMode="HighQuality" Source="/Resources/Images/ChevronDown.png" Width="15" VerticalAlignment="Center" Visibility="Collapsed"/>
                            </StackPanel>
                        </DockPanel>
                        <StackPanel x:Name="CanceledOrdersPanel" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Window>
